{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{client}.database.windows.net,1433;Database={client}-db;Authentication=Active Directory Default;",
    "AzureBlobStorage": "@Microsoft.KeyVault(SecretUri=https://{client}-kv.vault.azure.net/secrets/BlobStorageConnectionString/)"
  },
  "Storage": {
    "Provider": "Azure",
    "PublicContainer": "property-images",
    "PrivateContainer": "application-documents"
  },
  "ClientBranding": {
    "CompanyName": "WebTerriane",
    "PrimaryColor": "#0A2342",
    "AccentColor": "#3DA9FC",
    "LogoUrl": "/uploads/branding/logo.png",
    "SupportEmail": "support@example.com",
    "WhatsAppNumber": "+27000000000"
  },
  "Email": {
    "Provider": "AzureCommunicationServices",
    "SenderAddress": "no-reply@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
